# Copia este archivo como monitoring/.env (ignorado por git).

# Contraseña del usuario admin de Grafana (para editar paneles y alertas).
GRAFANA_ADMIN_PASSWORD=

# Token con el que Grafana envía las alertas a la plataforma. Debe ser el MISMO
# valor que PLATFORM_ALERTS_TOKEN en Admin-institucional/server/.env (mínimo 32
# caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_ALERTS_TOKEN=

# Solo si la API de la plataforma no está en el puerto 4300 de esta PC:
# PLATFORM_ALERTS_URL=http://host.docker.internal:4300/api/platform/alerts/webhook
