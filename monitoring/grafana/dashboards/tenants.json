          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"tenants\",tenant=~\"$tenant\",environment=~\"$environment\"} / node_memory_MemTotal_bytes{job=\"tenants\",tenant=~\"$tenant\",environment=~\"$environment\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
