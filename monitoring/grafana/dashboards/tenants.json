        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (tenant, le) (rate(http_server_request_duration_seconds_bucket{job=\"tenants\",tenant=~\"$tenant\",environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
