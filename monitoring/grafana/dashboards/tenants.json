        "w": 12,
        "x": 12,
        "y": 32
      },
      "type": "timeseries",
      "title": "Tiempo del chequeo de salud",
      "description": "Duración del GET a /api/health (backend) y a / (frontend).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "httpcheck_duration_milliseconds{job=\"tenants\",tenant=~\"$tenant\",environment=~\"$environment\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
