HOST=127.0.0.1
PORT=4300
PLATFORM_DATABASE_URL=postgresql://asistencia_platform:CAMBIAR_PASSWORD_DB@127.0.0.1:5432/asistencia_platform
PLATFORM_ADMIN_NAME=Operador
PLATFORM_ADMIN_EMAIL=operador@example.com
PLATFORM_ADMIN_PASSWORD=

# URL pública de asistencia. Separa varias instalaciones con comas.
PLATFORM_TENANT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En desarrollo, permite copiar el enlace de invitación desde el panel.
PLATFORM_MAIL_TRANSPORT=preview

# Para correo real, configura el remitente y el servicio SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURE=false

# En producción, usar HTTPS en el proxy y en las instalaciones vinculadas.
# NODE_ENV=production

# Clave AES-256 con la que se cifran los secretos de cada tenant en la base de la
# plataforma (contraseña de su BD, JWT_SECRET y clave de invitación). 32 bytes en
# base64. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, la plataforma ya no puede volver a desplegar los tenants existentes.
PLATFORM_SECRETS_KEY=

# Aprovisionamiento de tenants (worker dentro de esta API). Usa Docker Desktop y el
# toolbox asistencia-iac-toolbox:1, las credenciales de ~/.aws y la clave SSH de
# ~/.ssh/asistencia, igual que los comandos manuales.
# PLATFORM_WORKER=off                         # desactiva el worker
# PLATFORM_OPERATOR_CIDRS=190.0.2.10/32       # por defecto se detecta tu IP pública
# AWS_PROFILE=default
# PLATFORM_REPO_ROOT=C:\ruta\al\repositorio   # por defecto, la raíz de este repositorio

# Token con el que Grafana llama a POST /api/platform/alerts/webhook (mínimo 32
# caracteres). Debe ser el mismo valor de PLATFORM_ALERTS_TOKEN en monitoring/.env.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_ALERTS_TOKEN=
