# Archivos de bloqueo temporales de LibreOffice
.~lock.*#

# Configuración local de las aplicaciones
.env
.env.*
!.env.example

/info

# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Packer
packer_cache/
manifest.json

# Ansible
*.retry

# Claves y certificados
*.pem
*.key
id_rsa*
id_ed25519*

# Por tenant: inventario de Ansible, secretos y archivos de trabajo (plataforma y scripts)
.artifacts/
.workspaces/

# Targets de Prometheus generados por la plataforma
monitoring/prometheus/targets/*.json

# Configuración del backend generada por el bootstrap (específica de cada cuenta AWS)
infra/terraform/tenant/backend.hcl
