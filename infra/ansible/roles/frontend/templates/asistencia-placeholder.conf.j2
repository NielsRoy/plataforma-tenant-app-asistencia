# Sitio provisional de la imagen. El despliegue lo reemplaza por la versión
# que sirve React y reenvía /api al backend del tenant.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/asistencia;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
