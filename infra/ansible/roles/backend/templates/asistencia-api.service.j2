[Unit]
Description=API de control de asistencia (NestJS)
After=network-online.target otelcol-contrib.service
Wants=network-online.target
# El código viene en la AMI; no arranca hasta que el despliegue escriba los secretos
ConditionPathExists={{ api_home }}/current/dist/main.js
ConditionPathExists=/etc/asistencia/api.env

[Service]
Type=simple
User={{ api_user }}
Group={{ api_user }}
WorkingDirectory={{ api_home }}/current
EnvironmentFile=/etc/asistencia/api.env
ExecStart=/usr/local/bin/node dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
