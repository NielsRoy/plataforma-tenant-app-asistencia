# Generado por Ansible para el tenant {{ tenant_slug }}. Contiene secretos: 0640 root:{{ api_user }}.
NODE_ENV=production
PORT={{ api_port }}
HOST=0.0.0.0
CORS_ORIGIN={{ app_url }}
APP_TZ={{ tenant_timezone }}

DB_HOST={{ database_private_ip }}
DB_PORT=5432
DB_NAME={{ tenant_db_name }}
DB_USER={{ tenant_db_user }}
DB_PASSWORD={{ tenant_db_password }}

JWT_SECRET={{ tenant_jwt_secret }}
JWT_EXPIRES_IN={{ jwt_expires_in }}

# Activación del primer administrador por invitación desde la plataforma
PLATFORM_TENANT_SLUG={{ tenant_slug }}
PLATFORM_BOOTSTRAP_KEY={{ tenant_bootstrap_key }}

# Métricas hacia el OpenTelemetry Collector local (Prometheus las lee en :8889)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=asistencia-api
APP_VERSION={{ app_version }}
